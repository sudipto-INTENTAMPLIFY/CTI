Options -Indexes
RewriteEngine On
RewriteRule ^api/website-leads/?$ api/website-leads.php [L,QSA]
RewriteRule ^api/signals/?$ api/signals.php [L,QSA]
RewriteRule ^api/content/?$ api/content.php [L,QSA]
RewriteRule ^api/vendors/?$ api/vendors.php [L,QSA]
RewriteRule ^admin/?$ admin.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "^(admin\.html|CTI_ADMIN\.js)$">
    Header always set Cache-Control "no-store, private"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.env|^\.cti_runtime">
  Require all denied
</FilesMatch>
