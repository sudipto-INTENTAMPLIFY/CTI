Options -Indexes
RewriteEngine On
RewriteRule ^api/website-leads/?$ api/website-leads.php [L,QSA]
RewriteRule ^api/signals/?$ api/signals.php [L,QSA]
RewriteRule ^api/content/?$ api/content.php [L,QSA]
RewriteRule ^api/vendors/?$ api/vendors.php [L,QSA]
RewriteRule ^admin/?$ admin.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' https: data:; connect-src 'self' https:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https:"
  <FilesMatch "^(admin\.html|CTI_ADMIN\.js)$">
    Header always set Cache-Control "no-store, private"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.env|^\.cti_runtime">
  Require all denied
</FilesMatch>
